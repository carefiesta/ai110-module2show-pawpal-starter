classDiagram
    %% Initial design, drawn before the method bodies were filled in.
    %% Owner cares for many pets. Each pet has many tasks.
    %% Scheduler reads the owner and builds a daily plan.

    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete()
    }

    class Pet {
        +str name
        +str species
        +int age
        +list tasks
        +add_task(task)
    }

    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +all_tasks() list
    }

    class Scheduler {
        +Owner owner
        +todays_schedule() list
    }

    Owner "1" --> "*" Pet : cares for
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
